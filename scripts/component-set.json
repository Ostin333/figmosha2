{
  "description": "Build or restyle a component set from a variant matrix, bound to variables, laid out as a grid",
  "checkpoint": true,
  "timeout": 120,
  "args": {
    "type": "object",
    "required": [
      "name",
      "variants"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "page": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "variants": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "base": {
        "type": "object"
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "when",
            "set"
          ],
          "properties": {
            "when": {
              "type": "object"
            },
            "set": {
              "type": "object"
            }
          }
        }
      },
      "text": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "property": {
            "type": "string"
          },
          "fill": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "number",
              "string"
            ]
          },
          "style": {
            "type": "string"
          },
          "font": {
            "type": "object"
          }
        }
      },
      "properties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name",
            "type",
            "layer"
          ]
        }
      },
      "arrange": {
        "type": [
          "object",
          "boolean"
        ]
      }
    }
  },
  "example": {
    "name": "Button",
    "variants": {
      "Type": [
        "Primary",
        "Secondary"
      ],
      "Size": [
        "S",
        "M"
      ]
    },
    "base": {
      "padding": [
        8,
        12
      ],
      "radius": 6,
      "spacing": 8,
      "fill": "#2563eb"
    },
    "text": {
      "value": "Button",
      "property": "Label",
      "fill": "#ffffff",
      "size": 14
    },
    "rules": [
      {
        "when": {
          "Size": "S"
        },
        "set": {
          "padding": [
            4,
            8
          ],
          "textSize": 12
        }
      },
      {
        "when": {
          "Type": "Secondary"
        },
        "set": {
          "fill": "#ffffff",
          "stroke": "#d1d5db",
          "strokeWeight": 1,
          "textFill": "#111827"
        }
      }
    ]
  }
}
